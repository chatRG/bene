{
  "name": "bene",
  "private": true,
  "version": "0.3.8",
  "type": "module",
  "description": "Bene \u2014 a source-available, local-first health & recovery coach for iOS and Android.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false",
    "shots": "bun scripts/screenshots.mjs",
    "shots:light": "SHOT_THEME=light bun scripts/screenshots.mjs",
    "shots:dark": "SHOT_THEME=dark bun scripts/screenshots.mjs",
    "shots:store": "bun scripts/store-screenshots.mjs",
    "test:e2e": "bun scripts/e2e.mjs",
    "test:back": "bun scripts/e2e-back.mjs",
    "test:backup": "bun scripts/e2e-backup.mjs",
    "test:empty": "bun scripts/e2e-empty.mjs",
    "test:pwa": "bun scripts/e2e-pwa.mjs",
    "test:a11y": "bun scripts/a11y-contrast.mjs",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-health": "^8.13.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.4.5"
}
